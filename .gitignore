# Byte-compiled / optimised files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
wheels/
*.spec.bak

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.hypothesis/

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.pyright/

# Local data — never commit personal data, databases or keys
*.sqlite
*.sqlite3
*.db
*.log
.env
.env.*
secrets.*
tidy-data/

# Synthetic data produced by manual testing / demos
sandbox/
demo-downloads/

# Editors and OS cruft
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Claude Code local settings
.claude/settings.local.json
